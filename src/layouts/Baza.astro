---
import '@fontsource-variable/manrope';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CosSertar from '../components/CosSertar.tsx';

interface Props {
  titlu: string;
  descriere?: string;
  /** Pagina de finalizare are antet simplificat, fără meniu. */
  simplu?: boolean;
}
const {
  titlu,
  descriere = 'Parfumuri și cosmetice originale la preț de outlet: testere, cutii deteriorate, ambalaje vechi și ultimele bucăți.',
  simplu = false,
} = Astro.props;
---

<!doctype html>
<html lang="ro">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titlu}</title>
    <meta name="description" content={descriere} />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <a class="sari" href="#continut">Sari la conținut</a>
    <Header simplu={simplu} />
    <main id="continut">
      <slot />
    </main>
    <Footer />
    <CosSertar client:idle />
    <div class="anunt" role="status" aria-live="polite" data-anunt></div>

    <script>
      import { adauga, ascultaCos, citesteCos, DESCHIDE_COS, type Linie } from '../lib/cos';

      const numar = document.querySelectorAll<HTMLElement>('[data-cos-numar]');
      const actualizeaza = (linii: Linie[]) => {
        const total = linii.reduce((s, l) => s + l.cantitate, 0);
        numar.forEach((el) => {
          el.textContent = String(total);
          el.hidden = total === 0;
        });
      };
      actualizeaza(citesteCos());
      ascultaCos(actualizeaza);

      // Un singur ascultător pentru toate butoanele „Adaugă", inclusiv cele randate de React.
      document.addEventListener('click', (e) => {
        const tinta = e.target as HTMLElement;
        const inima = tinta.closest<HTMLElement>('[data-favorit]');
        if (inima) {
          // TODO(real): favoritele se salvează în contul clientului.
          inima.setAttribute('aria-pressed', String(inima.getAttribute('aria-pressed') !== 'true'));
          return;
        }
        const buton = tinta.closest<HTMLElement>('[data-adauga]');
        if (buton) {
          const cantitate = Number(buton.dataset.cantitate ?? 1);
          adauga(buton.dataset.adauga!, Number(buton.dataset.stoc ?? 99), cantitate);
          window.dispatchEvent(new Event(DESCHIDE_COS));
          return;
        }
        if (tinta.closest('[data-deschide-cos]')) window.dispatchEvent(new Event(DESCHIDE_COS));
      });
    </script>
  </body>
</html>
